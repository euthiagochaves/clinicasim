# ClinicaSim Environment Configuration
#
# Este arquivo é um template para variáveis de ambiente.
# Copie para .env.local e preencha com suas credenciais.
#
# ⚠️  IMPORTANTE: Nunca commitar .env.local ou valores reais de secrets!

# ============================================
# ASP.NET Core Configuration
# ============================================

# Ambiente de execução
# Valores: Development, Production, Staging
ASPNETCORE_ENVIRONMENT=Development

# URLs de escuta
# Deve incluir protocolo e porta
ASPNETCORE_URLS=http://localhost:5000

# ============================================
# Database Configuration
# ============================================

# Connection String para PostgreSQL
#
# Local PostgreSQL:
# postgresql://postgres:PASSWORD@localhost:5432/clinicasim
#
# Supabase (Cloud):
# postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres?schema=public
#
# Windows Authentication (não recomendado para este projeto):
# Server=localhost;Database=clinicasim;Integrated Security=true;
#
ConnectionStrings__ClinicaSim=postgresql://postgres:password@localhost:5432/clinicasim

# ============================================
# Logging Configuration (Futuro)
# ============================================

# Nível de log
# Valores: Trace, Debug, Information, Warning, Error, Critical, None
LOGLEVEL=Information

# Arquivo de log (opcional)
LOGFILE=logs/clinicasim.log

# ============================================
# Security Configuration (Futuro)
# ============================================

# JWT Secret (para autenticação futura)
# JWT_SECRET=your-super-secret-key-at-least-32-characters-long

# API Key (para autenticação de 3os)
# API_KEY=your-api-key-here

# ============================================
# CORS Configuration
# ============================================

# Origin permitido para CORS (desenvolvimento)
# Em produção, usar domínio específico
CORS_ORIGIN=http://localhost:4200

# ============================================
# Email Configuration (Futuro)
# ============================================

# SMTP Server
# SMTP_HOST=smtp.gmail.com

# SMTP Port
# SMTP_PORT=587

# SMTP Username
# SMTP_USER=your-email@gmail.com

# SMTP Password
# SMTP_PASSWORD=your-app-password

# From Address
# MAIL_FROM=noreply@clinicasim.com

# ============================================
# AWS/Storage Configuration (Futuro)
# ============================================

# AWS Access Key
# AWS_ACCESS_KEY_ID=your-access-key

# AWS Secret Key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS Region
# AWS_REGION=us-east-1

# S3 Bucket para PDFs
# AWS_S3_BUCKET=clinicasim-pdfs

# ============================================
# Feature Flags (Futuro)
# ============================================

# Enable User Authentication
# FEATURE_AUTH=false

# Enable Analytics
# FEATURE_ANALYTICS=false

# Enable Email Notifications
# FEATURE_EMAIL=false

# ============================================
# Troubleshooting
# ============================================

# Se está tendo problemas:
#
# 1. Verifique se PostgreSQL está rodando:
#    docker ps | grep postgres
#    # ou
#    psql -U postgres -c "SELECT 1;"
#
# 2. Verifique connection string:
#    psql -U postgres -h localhost -d clinicasim -c "SELECT 1;"
#
# 3. Verifique migrations:
#    dotnet ef database update -p ClinicaSim.Infrastructure
#
# 4. Verifique logs:
#    tail -f logs/clinicasim.log
